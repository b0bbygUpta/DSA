class Solution {
    public int minMoves2(int[] nums) {
        int n=nums.length;
        int ele=n/2;

        // System.out.println("ele: "+ele);

        Arrays.sort(nums);
        // System.out.println("nums: "+Arrays.toString(nums));

        int ans=0;
        
        for(int i=0;i<n;i++){
            ans+=Math.abs(nums[ele]-nums[i]);
        }


        return ans;





        // return 0;


    }
}














