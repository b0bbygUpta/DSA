// Leetcode 2243



class Solution {
    public String digitSum(String s, int k) {
        while(s.length() > k){
            s=help(s,k);
        }        
        return s;
    }
    public String help(String s, int k){
        StringBuilder ans=new StringBuilder();

        for(int i=0;i<s.length();i+=k){
            int sum=0;
            for(int j=i;j<Math.min(i+k,s.length());j++){
                sum+=s.charAt(j)-'0';
            }
            ans.append(sum);
        }
        return ans.toString();
    }
}


