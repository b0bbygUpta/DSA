// Leetcode 453









class Solution {
    public int minMoves(int[] nums) {
      int lo=Arrays.stream(nums).min().getAsInt(), moves=0;
      for(int x: nums) moves+=x-lo;
      return moves;  
    }
}








class Solution {
    public int minMoves(int[] nums) {
        int n=nums.length;
        if(n<=1 || nums==null) return 0;
        int min=nums[0];
        for(int i: nums){
            if(i<min){
                min=i;
            }
        }
        int moves=0;
        for(int i: nums){
            moves+=i-min;
        }
        return moves;

    }
}










class Solution {
    public int minMoves(int[] nums) {
        int n=nums.length;
        int min=nums[0];
        int sum=0;
        for(int i:nums){
            min=Math.min(min,i);
            sum+=i;
        }
        return (int)(sum-(long)min*n);

    }
}














