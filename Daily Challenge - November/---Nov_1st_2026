// Time Limit Exceeded 


class Solution {
    public int minMoves(int[] nums) {

        int n = nums.length;
        int count=0;
        
        if(check(nums)){
            return 0;
        }
        
        while(!check(nums)){
            inc(nums);
            count++;
        }

        // System.out.println("arr: " + Arrays.toString(nums));
        // System.out.println("equal: " + check(nums));
        // System.out.println("count: "+count);

        return count;

    }

    private void inc(int[] arr){
        int n=arr.length;
        // index of maximum element
        int maxidx = 0;
        for(int i = 1; i < n; i++){
            if(arr[i] > arr[maxidx]){
                maxidx = i;
            }
        }

        for(int i = 0; i < n; i++){
            if(i != maxidx){
                arr[i]++;
            }
        }
    }

    private boolean check(int[] arr){
        
        for(int i = 1; i < arr.length; i++){
            if(arr[i] != arr[i - 1]){
                return false;
            }
        }

        return true;
    }
}
