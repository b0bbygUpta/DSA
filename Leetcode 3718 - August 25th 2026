------ Leetcode 3718 ------
-- Smallest Mising Multiple of K --

*************************** JAVA Solution **********************************

class Solution {
    public int missingMultiple(int[] nums, int k) {
        Set<Integer> set=new HashSet<>();
        for(int i: nums){
            set.add(i);

        }
        int j=1;
        for(int i=1;i<=nums.length+1;i++){
            j=i*k;
            if(!set.contains(j)){
                return j;
            }
        }
        return -1;
    }
}
