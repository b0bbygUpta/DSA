----- Leetcode 3622 -----
-- Check Divisibility by Digit Sum and Product --

APPROACH I:
// Using two different functions for 'Product' and 'Sum'

class Solution {
    public boolean checkDivisibility(int n) {
        int addition=product(n)+sum(n);
        if(n % addition == 0){
            return true;
        }
        return false;
    }
    private int product(int n){
        int p=1;
        while(n>0){
            p*=n%10;
            n/=10;
        }
        return p;
    }
    private int sum(int n){
        int s=0;
        while(n>0){
            s+=n%10;
            n/=10;
        }
        return s;
    }
}


APPROACH II:
// Using a single function for both 'Sum' and 'Product'

class Solution {
    public boolean checkDivisibility(int n) {
        if(n % addition(n) == 0){
            return true;
        }
        return false;
    }
    private int addition(int n){
        int temp=n;
        int sum=0;
        int product=1;
        while(n>0){
            int d=n%10;
            sum+=d;
            product*=d;
            n/=10;
        }
        int add=sum+product;
        
        return add;
    }
}

APPROACH III:
// Without any function approach

class Solution {
    public boolean checkDivisibility(int n) {
       
        int temp=n;
        int sum=0;
        int product=1;
        while(n>0){
            int d=n%10;
            sum+=d;
            product*=d;
            n/=10;
        }
        int add=sum+product;
        
       
        if(temp % add == 0){
            return true;
        }
        return false;
    }
}
