----- Leetcode 9 ----- 
-- Palindrome NUmber -- 

// Using 'reverse' as a helper function
class Solution {
    public boolean isPalindrome(int x) {
        int rev=reverse(x);
        if(rev == x){
            return true;
        }
        return false;
    }
    private int reverse(int x){
        int res=0;
        while(x>0){
            res=(res*10)+(x%10);
            x/=10;

        }
        return res;
    }
}
