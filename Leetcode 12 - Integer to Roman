----- Leetcode 12  ----- 
-- Integer to Roman -- 


**************** JAVA Solution ***********************

// Using LinkedHashMap 

class Solution {
    public static final Map<Integer,String> map=new LinkedHashMap<>();
    static{
        map.put(1000,"M");
        map.put(900,"CM");
        map.put(500,"D");
        map.put(400,"CD");
        map.put(100,"C");
        map.put(90,"XC");
        map.put(50,"L");
        map.put(40,"XL");
        map.put(10,"X");
        map.put(9,"IX");
        map.put(5,"V");
        map.put(4,"IV");
        map.put(1,"I");    
       
    }
    public String intToRoman(int num) {
        StringBuilder res=new StringBuilder();

        for(Map.Entry<Integer,String> entry:map.entrySet()){
            while(num>=entry.getKey()){
                res.append(entry.getValue());
                num-=entry.getKey();
            }
        }

        return res.toString();
    }
}
