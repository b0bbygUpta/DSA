    public static int[] helper(List<Integer> l1, List<Integer> l2){
      int m=l1.size();
      int n=l2.size();

      int[] res=new int[m+n];
      for(int i=0;i<res.length;i++){
        if(i<m){
          res[i]=l1.get(i);
        }
        else{
          res[i]=l2.get(i-m);
        }
      }
      
      System.out.println("res address: "+res);
      System.out.println("res: "+Arrays.toString(res));

      return res;
    }
}
